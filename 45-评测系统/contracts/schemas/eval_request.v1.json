{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreambuddy.local/contracts/schemas/eval_request.v1.json",
  "title": "EvalRequest v1",
  "description": "评测申请（SPEC-45 §13.1）：POST /api/v1/eval/submit 请求体",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_ref",
    "category",
    "object_type",
    "submitter",
    "purpose",
    "spec_id",
    "env_manifest"
  ],
  "properties": {
    "object_ref": {
      "type": "string",
      "minLength": 1,
      "description": "被评测对象引用（repo/commit/制品 URI 等）"
    },
    "category": {
      "type": "string",
      "enum": ["finance", "ai", "engineering"]
    },
    "object_type": {
      "type": "string",
      "enum": ["strategy", "model", "service", "code_artifact", "dataset", "knowledge"]
    },
    "submitter": { "type": "string", "minLength": 1 },
    "purpose": {
      "type": "string",
      "enum": ["l0_settle", "deploy"]
    },
    "priority": {
      "type": "string",
      "enum": ["normal", "high"],
      "default": "normal"
    },
    "spec_id": {
      "type": "string",
      "pattern": "^EVS-\\d{8}-\\d{4}$"
    },
    "env_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoints"],
      "properties": {
        "runtime": { "type": "string" },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "运行端点清单；缺失即拒绝受理（§13.1）"
        },
        "resources": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "secret_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "密钥引用名，禁止直接提交密钥值（§15）"
        }
      }
    }
  }
}
