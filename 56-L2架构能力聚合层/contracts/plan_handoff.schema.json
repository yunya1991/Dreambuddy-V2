{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreambuddy.local/56/plan_handoff.schema.json",
  "title": "L2 Plan & Handoff v1.1",
  "description": "规划产物与控制权契约：mode 明确 self / handoff（交权）/ agents_as_tools（保留控制权），并冻结预算与外部验收。v1.1 起强制 trace_id。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "plan_id", "run_id", "intent", "mode", "steps", "budget", "validation"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "trace_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{3,64}$" },
    "plan_id": { "type": "string", "pattern": "^plan-[A-Za-z0-9._-]{3,64}$" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{3,64}$" },
    "intent": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["self", "handoff", "agents_as_tools"] },
    "handoff": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["target", "control"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "control": { "enum": ["transferred", "retained"] },
        "return_to": { "type": ["string", "null"] }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "action", "tool", "acceptance"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "action": { "type": "string", "minLength": 1 },
          "tool": { "type": "string", "pattern": "^l[0-2]\\.[a-z0-9_]+\\.[a-z0-9_]+$" },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_steps", "soft_tokens", "hard_tokens"],
      "properties": {
        "max_steps": { "type": "integer", "minimum": 1 },
        "soft_tokens": { "type": "integer", "minimum": 1 },
        "hard_tokens": { "type": "integer", "minimum": 1 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluators", "tripwire"],
      "properties": {
        "evaluators": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "tripwire": {
          "type": "array",
          "items": { "type": "string", "pattern": "^G-L2-[0-9]+$" }
        }
      },
      "anyOf": [
        { "properties": { "evaluators": { "minItems": 1 } } },
        { "properties": { "tripwire": { "minItems": 1 } } }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "handoff" } } },
      "then": {
        "required": ["handoff"],
        "properties": { "handoff": { "type": "object", "properties": { "control": { "const": "transferred" } } } }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "agents_as_tools" } } },
      "then": {
        "required": ["handoff"],
        "properties": {
          "handoff": {
            "type": "object",
            "required": ["control", "return_to"],
            "properties": { "control": { "const": "retained" }, "return_to": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "self" } } },
      "then": { "properties": { "handoff": { "type": "null" } } }
    }
  ]
}
