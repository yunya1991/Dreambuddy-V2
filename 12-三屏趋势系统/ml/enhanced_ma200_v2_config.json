  "design_rationale": {
    "weekly_ma200_dip_buy": "周线MA200是BTC长期牛熊分水岭，跌破后分仓抄底可捕捉大底，左侧布局降低平均成本",
    "layered_short_3_5": "跌破MA200先开3成试探，斜率转负加到5成，避免一次性满仓做空被反弹打爆",
    "fib_take_profit": "下跌趋势中分阶段锁定利润，避免盈利被反弹回吐",
    "alt_bear_no_trade": "小币在熊市中做多做空双杀风险极高，完全空仓是最优选择；只有BTC+自身双牛才做多",
    "warmup_260": "周线MA200需要约200周数据，日线warmup设为260确保所有指标有效"
  },

