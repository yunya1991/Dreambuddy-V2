  "strategy_class": "EnhancedMA200Strategy",
  "description": "在经典MA200牛熊法则基础上，加入周线MA200分仓抄底、BTC分层做空+斐波那契止盈、小币熊市完全空仓三大新法则",
  "created_at": "2026-07-18",
  "baseline_status": {
    "is_baseline": true,
    "baseline_confirmed_at": "2026-07-18",
    "baseline_reason": "全策略统一回测对比中，主动策略收益第1(+307.05%)、夏普第1(0.482)、4币种全部正收益（唯一），综合表现最优",
    "comparison_with": ["BuyAndHoldStrategy", "MovingAverageStrategy", "MA200TrendFollowingStrategy", "LeastResistanceStrategy", "AdaptiveLeastResistanceStrategy"],
    "comparison_script": "ml/full_strategy_comparison.py",
    "comparison_output": "ml/full_strategy_comparison_output.txt"
  },
  "data_range": "2017-10-10 ~ 2026-07-16（BTC/ETH 3202天，SOL 2117天，UNI 2130天）",
  "optimization_method": "经验法则驱动 + 9年历史数据回测验证",

  "core_rules": {
    "rule_1_weekly_dip_buy": {
      "name": "周线MA200分仓抄底",
      "trigger": "BTC价格跌至周线MA200以下",
      "logic": "按跌幅分4档建仓，每跌5%加仓一档，最大仓位80%",
      "params": {
        "weekly_ma200_dip_buy": true,
        "dip_buy_max_position": 0.8,
        "dip_buy_levels": 4,
        "dip_buy_step_pct": 5.0
      }
    },
    "rule_2_btc_layered_short": {
      "name": "BTC分层做空 + 斐波那契止盈",
      "trigger_level1": "BTC跌破日线MA200 → 开3成空仓",
      "trigger_level2": "日线MA200的5日斜率为负 → 加仓至5成",
      "take_profit": "斐波那契分阶段止盈(23.6%/38.2%/50%/61.8%)，每档减仓25%",
      "params": {
        "bear_short_level1_pct": 0.3,
        "bear_short_level2_pct": 0.5,
        "fib_take_profit": true,
        "fib_levels": [0.236, 0.382, 0.5, 0.618]
      }
    },
    "rule_3_alt_bear_no_trade": {
      "name": "小币熊市完全禁止开仓",
      "logic": "小币(非BTC)在BTC非牛市时完全空仓，不做多也不做空；仅当BTC和自身同时处于牛市才满仓做多",
      "params": {
        "alt_bear_no_trade": true
      }
    }
  },

  "base_params": {
    "ma_period": 200,
    "slope_period": 5,
    "max_position": 1.0,
    "warmup_periods": 260
  },

