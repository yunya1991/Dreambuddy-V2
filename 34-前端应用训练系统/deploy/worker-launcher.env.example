# /etc/dreambuddy/worker-launcher.env
# 权限：chown dreambuddy:dreambuddy + chmod 600；不得写入任何 API key（凭据由宿主注入）

D3_ROOT=/opt/dreambuddy
D3_ROLES_PATH=/opt/dreambuddy/47-MCP管理系统/registry/mcp_capabilities.yaml
# 本地 roster（逗号分隔）；不填表示接受 Router 分派的任意 worker_id（仍校验角色白名单）
D3_WORKERS=
D3_EXECUTOR=inproc
D3_PROFILE=sandbox
D3_MAX_CONCURRENCY=8
D3_POLL_INTERVAL=0.5
D3_DSH_BIN=/opt/dreambuddy/.venv/bin/dsh

# 子会话必须显式模型路由（空路由会导致 child 立即 stopReason=error）
D3_MODEL_PROVIDER=deepseek
D3_MODEL_NAME=deepseek-chat
