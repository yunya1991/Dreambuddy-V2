{
    "max_open_trades": 3,
    "trading_mode": "spot",
    "stake_currency": "USDT",
    "stake_amount": 60,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "timeframe": "1h",
    "dry_run": true,
    "cancel_open_orders_on_exit": false,
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
