{
    "datadir": "user_data/data",
    "sandbox_policy": {
        "deny_network": false,
        "auto_download_data": false,
        "allow_hosts": [
            "api.gateio.ws",
            "api.gateio.com"
        ]
    },
    "max_open_trades": 2,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "dry_run": true,
    "dry_run_wallet": 10000,
    "cancel_entry_after": 300,
    "cancel_exit_after": 300,
    "fee": 0.0004,
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "unfilledtimeout": {
        "entry": 30,
        "exit": 30,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": false,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": false
    },
    "order_types": {
        "entry": "limit",
        "exit": "limit",
        "stoploss": "limit",
        "stoploss_on_exchange": false
    },
    "exchange": {
        "name": "gate",
        "key": "test",
        "secret": "test",
        "skip_pair_validation": true,
        "pair_whitelist": [
            "BTC/USDT:USDT",
            "ETH/USDT:USDT",
            "SOL/USDT:USDT"
        ],
        "ccxt_config": {
            "enableRateLimit": true,
            "timeout": 180000,
            "options": {
                "defaultType": "swap"
            }
        },
        "ccxt_async_config": {
            "timeout": 180000
        }
    },
    "pairlists": [
        {
            "method": "StaticPairList",
            "allow_inactive": true
        }
    ],
    "timeframe": "1h",
    "strategy": "Strategy005",
    "position_adjustment_enable": true,
    "dataformat_ohlcv": "json",
    "dataformat_trades": "jsongz"
}
