{
  "swarms": [
    {
      "id": "market_intel_swarm",
      "goal": "输出可执行的市场情报摘要并标注证据可信度",
      "agents": [
        {"name": "sentiment_agent", "focus": "舆情与新闻热度变化"},
        {"name": "macro_agent", "focus": "宏观事件与风险偏好变化"},
        {"name": "onchain_agent", "focus": "链上资金与地址行为"},
        {"name": "strategy_review_agent", "focus": "策略表现与风险归因"}
      ],
      "output_contract": {
        "required_fields": ["trace_id", "summary", "evidence", "risk_flags", "actions"],
        "max_actions": 5
      }
    },
    {
      "id": "ops_guard_swarm",
      "goal": "在不改交易执行面的前提下给出运维止血建议",
      "agents": [
        {"name": "ops_guard_agent", "focus": "系统健康与告警聚合"},
        {"name": "execution_agent", "focus": "执行质量与异常重试"},
        {"name": "governance_agent", "focus": "审批链与合规检查"}
      ],
      "output_contract": {
        "required_fields": ["trace_id", "incident_level", "recommendations", "approval_required", "rollback_hint"],
        "max_recommendations": 6
      }
    }
  ]
}
