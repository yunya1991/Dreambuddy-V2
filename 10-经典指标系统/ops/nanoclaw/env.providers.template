# NanoClaw OpenAI 兼容后端切换模板
# 只需改这 4 个变量：
# - NANO_MODEL_BACKEND
# - OPENAI_COMPAT_BASE_URL
# - OPENAI_API_KEY
# - OPENAI_MODEL

########################################
# DashScope（阿里百炼）
########################################
NANO_MODEL_BACKEND=openai_compat
OPENAI_COMPAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-your-dashscope-key
OPENAI_MODEL=qwen-plus

########################################
# Kimi（月之暗面）
########################################
NANO_MODEL_BACKEND=openai_compat
OPENAI_COMPAT_BASE_URL=https://api.moonshot.cn/v1
OPENAI_API_KEY=sk-your-kimi-key
OPENAI_MODEL=moonshot-v1-8k

########################################
# 智谱（GLM）
########################################
NANO_MODEL_BACKEND=openai_compat
OPENAI_COMPAT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_API_KEY=your-zhipu-key
OPENAI_MODEL=glm-4-plus
