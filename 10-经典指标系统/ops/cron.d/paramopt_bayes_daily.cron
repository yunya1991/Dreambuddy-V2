30 3 * * * PROJECT_DIR=<PROJECT_DIR> PYTHON_BIN=<PROJECT_DIR>/venv/bin/python3 TELEGRAM_ON_FAIL=1 EXTRA_ARGS="--transport http --base-url http://127.0.0.1:8092 --eval-mode rolling --family lr --key max_open_trades --folds 5 --n-init 8 --n-iter 24 --apply-config --order-test --order-notional-usdc 100 --order-auto-bump-to-min --order-ignore-cooldown --order-ignore-post-close-freeze" <PROJECT_DIR>/ops/paramopt_bayes_daily.sh >> /var/log/paramopt_bayes_daily.log 2>&1
