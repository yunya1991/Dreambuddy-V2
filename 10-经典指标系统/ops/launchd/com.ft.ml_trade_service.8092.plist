<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>PORT=__PORT__</string>
    <string>ML_USER_DATA_DIR=__ML_USER_DATA_DIR__</string>
    <string>ML_STRICT_USER_DOTENV=__ML_STRICT_USER_DOTENV__</string>
    <string>python3</string>
    <string>ml_trade_service.py</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/ml_trade_service___PROFILE_____PORT__.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/ml_trade_service___PROFILE_____PORT__.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <key>ThrottleInterval</key>
  <integer>3</integer>
</dict>
</plist>
