<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>PROJECT_DIR=__PROJECT_DIR__ PYTHON_BIN=__PYTHON_BIN__ RESEARCH_ROOT=__RESEARCH_ROOT__ SYNC_BASELINE_SEC=__SYNC_BASELINE_SEC__ SYNC_BURST_SEC=__SYNC_BURST_SEC__ SYNC_BURST_HOLD_SEC=__SYNC_BURST_HOLD_SEC__ SYNC_SLA_SEC=__SYNC_SLA_SEC__ __PROJECT_DIR__/ops/fundamental_research_sync.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>__INTERVAL_SEC__</integer>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/user_data/logs/fundamental_research_sync.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/user_data/logs/fundamental_research_sync.err.log</string>

  <key>ThrottleInterval</key>
  <integer>3</integer>
</dict>
</plist>
