# 环境变量模板文件
# 复制此文件为 .env 并填入实际值
# 注意: .env 文件应添加到 .gitignore 中

# 阿里云配置
ALIYUN_ACCESS_KEY_ID=your_access_key_here
ALIYUN_ACCESS_KEY_SECRET=your_secret_key_here
ALIYUN_REGION=ap-northeast-1

# OKX 交易所配置
OKX_API_KEY=your_okx_api_key
OKX_SECRET_KEY=your_okx_secret_key
OKX_PASSPHRASE=your_okx_passphrase

# Binance 交易所配置
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key

# 服务器配置
SERVER_1_IP=your_server_1_ip
SERVER_2_IP=your_server_2_ip

# WebUI 认证
WEBUI_USERNAME=your_username
WEBUI_PASSWORD=your_password

# JWT 密钥
JWT_SECRET_KEY=your_jwt_secret_key

CONFIG_TOKEN=
MAINTENANCE_TOKEN=
LISTEN_HOST=127.0.0.1
PORT=8092

# ===== Local LLM (OpenAI-compatible, e.g. llama.cpp server) =====
AGENT_OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8080
AGENT_OPENAI_COMPAT_MODEL=qwen3.5-4b
AGENT_OPENAI_COMPAT_API_KEY=
AGENT_OPENAI_COMPAT_JSON_MODE=1

# ===== Smart LLM Router =====
# auto: small(default) → code_fix(local large) → explore(remote)
AGENT_LLM_ROUTER_ENABLED=1
AGENT_LLM_SMALL_PROVIDER=openai_compat
AGENT_LLM_SMALL_MODEL=qwen3.5-4b
AGENT_LLM_CODE_PROVIDER=ollama
AGENT_LLM_CODE_MODEL=qwen2.5-coder:latest
AGENT_LLM_EXPLORE_PROVIDER=dashscope
AGENT_LLM_EXPLORE_MODEL=qwen3-coder-plus
AGENT_LLM_ROUTER_RULES_JSON=

# 数据库配置
DB_PASSWORD=your_db_password

# ===== Workspace runtime selection =====
# 仅启用 V3 系统构建
ACTIVE_SYSTEM=v3
# 固定 Python 导入解析到 V3 路径（本地）
PYTHONPATH=/Users/zhangjiangtao/ft_userdata/v3_trading_system
# V3 Web UI 默认端口
V3_WEB_UI_PORT=8002

# 安全提醒:
# 1. 定期轮换所有密钥
# 2. 使用强密码
# 3. 启用多因子认证
# 4. 限制API权限
# 5. 配置IP白名单

# Hyperliquid 集成（只读 info 端点）
# 设置链上用户地址（无需私钥即可读取信息）。
HYPERLIQUID_USER_ADDRESS=
# 可选：覆盖默认 info URL
HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info

# 轮询配置（可选）
# MONITOR_SYMBOLS 逗号分隔的监控资产列表
# HL_POLL_INTERVAL_SEC 后台轮询间隔秒数
# HL_STALE_THRESHOLD_SEC API返回数据的陈旧阈值（秒），超过则强制刷新
MONITOR_SYMBOLS=BTCUSDT,ETHUSDT
HL_POLL_INTERVAL_SEC=5
HL_STALE_THRESHOLD_SEC=10

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379

# Binance WebSocket 采集配置
# BINANCE_SYMBOL 控制默认订阅的主交易对（当未设置 BINANCE_STREAMS 时生效）
# BINANCE_STREAMS 可覆写成多个流，逗号分隔，例如：
#   btcusdt@aggTrade,ethusdt@aggTrade
BINANCE_SYMBOL=BTCUSDT
BINANCE_STREAMS=

# 特征窗口配置（全局或按资产覆盖）
# 全局：逗号分隔，如 10,50 表示并行计算 MA10 与 MA50
FEATURE_WINDOWS=10
# 覆盖：对某资产单独设置，例如：
# FEATURE_WINDOWS_BTCUSDT=10,50
# FEATURE_WINDOWS_ETHUSDT=20,100

# TimescaleDB 连接（DSN 格式）
# 例如：postgresql://user:password@localhost:5432/mydatabase
TIMESCALE_DSN=postgresql://user:password@localhost:5432/mydatabase

# TimescaleDB 端口回退（可选，逗号分隔）。当指定端口不可用时，按顺序尝试。
# 例如：优先容器 5433，其次本地 5432
TIMESCALE_FALLBACK_PORTS=5433,5432

# MinIO 连接
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
