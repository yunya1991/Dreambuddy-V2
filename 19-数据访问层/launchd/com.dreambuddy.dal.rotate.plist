<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dreambuddy.dal.rotate</string>

    <key>ProgramArguments</key>
    <array>
        <string>python3</string>
        <string>-m</string>
        <string>dreambuddy_dal.cron_runner</string>
        <string>rotate</string>
    </array>

    <!-- 每天 05:00 轮转（备份后 1 小时） -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>5</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>DATA_DIR</key>
        <string>/Users/zhangjiangtao/WorkBuddy/dreambuddy-v2/data</string>
        <key>BACKUP_DIR</key>
        <string>$(DATA_DIR)/backups</string>
        <key>BACKUP_KEEP</key>
        <string>7</string>
        <key>PYTHONPATH</key>
        <string>/Users/zhangjiangtao/WorkBuddy/dreambuddy-v2/19-数据访问层</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/dreambuddy_dal_rotate.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/dreambuddy_dal_rotate.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
