DATABASE_URL="postgresql://postgres@localhost:5432/gateway"
NEXTAUTH_URL="http://localhost:3456"
NEXTAUTH_SECRET="replace-with-min-32-chars"
AUTH_SECRET="replace-with-min-32-chars"
ENCRYPTION_KEY="replace-with-32-chars"
WORKBUDDY_WS_URL="ws://localhost:8080"
WORKBUDDY_API_URL="http://localhost:8080"
HUB_BASE_URL="http://127.0.0.1:8787"
NEXT_PUBLIC_BRIDGE_URL="http://127.0.0.1:3847"

# ========================================
# 基础设施开关（默认已启用，无需配置）
# ========================================
# Scheduler/CostKeeper/SkipGate/Compressor
# 默认: true (已启用)，设为 false 可禁用
USE_SCHEDULER="true"

# Dynamic Chain (Plan-Execute-Reflect 闭环)
# 默认: true (已启用)，设为 false 可禁用
ENABLE_DYNAMIC_CHAIN="true"
