+def test_t13_runs_13_16_22_in_order_and_caps_size():
+    """13→16→22 顺序正确；16 只做上限约束，不放大调用方仓位。
+
+    equity=10000, pct=0.2, px=50000, ct_val=0.01 → 合约面值 500 USDT
+    cap = 2000/500 = 4 张。调用方 sz=0.01 张（约 5 USDT）不得被放大到 4 张。
+    """
+    events = []
+    fake_okx = _FakeOkx()
