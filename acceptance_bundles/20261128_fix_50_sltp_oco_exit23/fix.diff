+
+    led.reconcile([], source="22-reconciled", ghost_confirm=lambda _i, _s: True)
+
+    cool = led.get_cooldown("LINK-USDT-SWAP")
+    assert cool["exit_reason"] == "ghost_stale"
+    assert cool["source"] == "22-reconciled"
