<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.dreambuddy.data-center-scheduler — 持续采集调度器 launchd 托管

  安装：
    cp com.dreambuddy.data-center-scheduler.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.dreambuddy.data-center-scheduler.plist

  卸载：
    launchctl unload ~/Library/LaunchAgents/com.dreambuddy.data-center-scheduler.plist

  查看状态：
    launchctl list | grep dreambuddy
    tail -f 18-数据获取中心/logs/scheduler.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dreambuddy.data-center-scheduler</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/anaconda3/bin/python3</string>
        <string>/Users/zhangjiangtao/WorkBuddy/dreambuddy-v2/18-数据获取中心/data_center_scheduler.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/zhangjiangtao/WorkBuddy/dreambuddy-v2/18-数据获取中心</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>LimitLoadToSessionType</key>
    <array><string>Aqua</string><string>Background</string></array>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>ExitTimeOut</key>
    <integer>25</integer>

    <key>StandardOutPath</key>
    <string>/Users/zhangjiangtao/WorkBuddy/dreambuddy-v2/18-数据获取中心/logs/scheduler.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/zhangjiangtao/WorkBuddy/dreambuddy-v2/18-数据获取中心/logs/scheduler.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/anaconda3/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONPATH</key>
        <string>/Users/zhangjiangtao/WorkBuddy/dreambuddy-v2/18-数据获取中心</string>
    </dict>
</dict>
</plist>
