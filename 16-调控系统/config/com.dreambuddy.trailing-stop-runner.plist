<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dreambuddy.trailing-stop-runner</string>

    <!-- 统一入口：与云端 systemd 共用同一可移植脚本（EXIT_MODE/PYTHONPATH/凭据由脚本接管） -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/zhangjiangtao/WorkBuddy/dreambuddy-v2/16-调控系统/scripts/run_trailing_stop_runner.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/zhangjiangtao/WorkBuddy/dreambuddy-v2/16-调控系统</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>RestartInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/zhangjiangtao/WorkBuddy/dreambuddy-v2/16-调控系统/logs/trailing_runner.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/zhangjiangtao/WorkBuddy/dreambuddy-v2/16-调控系统/logs/trailing_runner.stderr.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
