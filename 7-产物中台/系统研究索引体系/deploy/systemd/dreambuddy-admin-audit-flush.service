[Unit]
Description=DreamBuddy 管理台审计 outbox 补偿（SPEC-7 §9）
Documentation=file:///home/luke/dreambuddy/7-产物中台/docs/SPEC-7-管理台写能力-v2.0.md
After=network-online.target

[Service]
Type=oneshot
User=luke
# 令牌从 EnvironmentFile 读取，禁止硬编码
EnvironmentFile=/home/luke/.config/dreambuddy/admin.env
ExecStart=/usr/bin/curl -sS -X POST \
  -H "Content-Type: application/json" \
  -H "X-Internal-Token: ${ADMIN_INTERNAL_TOKEN}" \
  http://127.0.0.1:3456/api/admin/jobs/audit-flush
TimeoutStartSec=120
