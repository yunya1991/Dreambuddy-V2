<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  DreamBuddy 裁决事件消费者（P2.5）
  WatchPaths 监视 .data/task-board：文件变化即跑一轮 --once，不做忙轮询。
  作用：verdict.updated → 唤醒 paused(waiting_verdict) Ticket（paused → live）。
  日志：/tmp/dreambuddy-verdict-consumer.*.log
  卸载：launchctl bootout gui/$(id -u)/com.dreambuddy.verdict-consumer
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dreambuddy.verdict-consumer</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-m</string>
    <string>core.verdict_event_consumer</string>
    <string>--once</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/zhangjiangtao/WorkBuddy/dreambuddy-v2/34-前端应用训练系统</string>
  <key>WatchPaths</key>
  <array>
    <string>/Users/zhangjiangtao/WorkBuddy/dreambuddy-v2/.data/task-board</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/dreambuddy-verdict-consumer.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/dreambuddy-verdict-consumer.err.log</string>
</dict>
</plist>
