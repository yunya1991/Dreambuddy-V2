# D3 Worker Launcher 环境示例（复制到 /etc/dreambuddy/worker-launcher.env）
# 默认关闭 Hermes：auto 在开关关闭时与 dsh-cli 字节等价。
D3_EXECUTOR=auto
D3_PROFILE=sandbox
D3_MAX_CONCURRENCY=8
D3_POLL_INTERVAL=0.5

# HermesExecutor 灰度开关（默认关闭；启用前必须完成 H1/H3 + 隔离测试）
enable_hermes_executor=0
hermes_executor_roles=research,engineer
hermes_executor_canary_pct=0

# 子会话必须显式模型路由
D3_MODEL_PROVIDER=
D3_MODEL_NAME=
