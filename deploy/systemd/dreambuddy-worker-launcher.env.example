# D3 Worker Launcher 环境示例（复制到 /etc/dreambuddy/worker-launcher.env）
# auto = 默认执行器与 inproc 完全一致；开关关闭时行为不变，只对
# worker_roles.executor=hermes 的角色按 canary 分流。
D3_EXECUTOR=auto
D3_PROFILE=sandbox
D3_MAX_CONCURRENCY=8
D3_POLL_INTERVAL=0.5

# HermesExecutor 灰度开关（默认关闭；启用前必须完成 H1/H3 + 隔离测试）
enable_hermes_executor=0
hermes_executor_roles=research,engineer
hermes_executor_canary_pct=0

# 可选：hermes 可执行文件（systemd PATH 未覆盖时显式指定）
# D3_HERMES_BIN=/usr/local/bin/hermes
# D3_MODEL_PROVIDER / D3_MODEL_NAME 为 DSH 子会话模型路由
D3_MODEL_PROVIDER=
D3_MODEL_NAME=
