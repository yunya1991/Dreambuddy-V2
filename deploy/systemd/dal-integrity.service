[Unit]
Description=Dreambuddy DAL SQLite integrity check
After=local-fs.target

[Service]
Type=oneshot
User=luke
Group=luke
WorkingDirectory=/home/luke/dreambuddy/19-数据访问层
Environment="HOME=/home/luke"
Environment="PYTHONPATH=/home/luke/dreambuddy/19-数据访问层"
Environment="DATA_DIR=/home/luke/dreambuddy/19-数据访问层/data"
Environment="DAL_DB_PATH=/home/luke/dreambuddy/19-数据访问层/data/dreambuddy_core.db"
ExecStart=/home/luke/venv-trading/bin/python -m dreambuddy_dal.cron_runner integrity
# 全库 integrity_check 会长时间持读事务，期间 WAL 无法 checkpoint；
# 结束后立刻回收，避免 -wal 累积（2026-11-25 曾涨到 12G）。
# 不加 `-`：脚本对库缺失/WAL 忙已返回 0，真正的失败必须让 unit 变 failed。
ExecStartPost=/home/luke/dreambuddy/deploy/ops/checkpoint-wal.sh
StandardOutput=append:/home/luke/logs/datacenter/dal-integrity.log
StandardError=append:/home/luke/logs/datacenter/dal-integrity.err.log
