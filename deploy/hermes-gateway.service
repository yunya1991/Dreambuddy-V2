[Unit]
Description=Hermes Gateway — Feishu Messaging
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=luke
WorkingDirectory=/home/luke/tmp
Environment="HOME=/home/luke"
Environment="HERMES_HOME=/home/luke/.hermes"
ExecStart=/usr/local/bin/hermes gateway run --replace
Restart=always
RestartSec=10
StandardOutput=append:/home/luke/.hermes/logs/gateway.log
StandardError=append:/home/luke/.hermes/logs/gateway.log

[Install]
WantedBy=multi-user.target
