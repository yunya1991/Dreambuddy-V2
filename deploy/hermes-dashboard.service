[Unit]
Description=Hermes Dashboard — Web UI on :9119
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=luke
WorkingDirectory=/home/luke/tmp
Environment="HOME=/home/luke"
Environment="HERMES_HOME=/home/luke/.hermes"
ExecStart=/usr/local/bin/hermes dashboard --port 9119 --host 127.0.0.1 --no-open
Restart=always
RestartSec=10
StandardOutput=append:/home/luke/.hermes/logs/dashboard.log
StandardError=append:/home/luke/.hermes/logs/dashboard.log

[Install]
WantedBy=multi-user.target
