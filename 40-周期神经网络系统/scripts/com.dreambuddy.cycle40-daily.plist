<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.dreambuddy.cycle40-daily — 40 系统日更流水线（含 P6 E3 Shadow）launchd 托管
  安装：cp 本文件 ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.dreambuddy.cycle40-daily.plist
  卸载：launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/com.dreambuddy.cycle40-daily.plist
  手动触发：launchctl kickstart gui/$(id -u)/com.dreambuddy.cycle40-daily
  日志：40-周期神经网络系统/logs/daily_pipeline_YYYYMMDD.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dreambuddy.cycle40-daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/zhangjiangtao/WorkBuddy/dreambuddy-v2/40-周期神经网络系统/scripts/run_daily_pipeline.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/zhangjiangtao/WorkBuddy/dreambuddy-v2/40-周期神经网络系统/scripts</string>

    <!-- 每日 09:00 本地（Asia/Shanghai）= UTC 01:00，日线收线后 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>9</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/zhangjiangtao/WorkBuddy/dreambuddy-v2/40-周期神经网络系统/logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/zhangjiangtao/WorkBuddy/dreambuddy-v2/40-周期神经网络系统/logs/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/anaconda3/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHON_BIN</key>
        <string>/opt/anaconda3/bin/python3</string>
        <key>DREAMBUDDY_ROOT</key>
        <string>/Users/zhangjiangtao/WorkBuddy/dreambuddy-v2</string>
    </dict>
</dict>
</plist>
