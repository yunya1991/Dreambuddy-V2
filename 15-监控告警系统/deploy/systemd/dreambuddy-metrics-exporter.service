[Unit]
Description=Dreambuddy business metrics exporter (read-only)
Documentation=file:///home/luke/dreambuddy/15-监控告警系统/docs/TECHNICAL_DESIGN.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=luke
Group=luke
WorkingDirectory=/home/luke/dreambuddy/15-监控告警系统
EnvironmentFile=/etc/dreambuddy-monitoring/monitoring.env
ExecStart=/home/luke/venv-trading/bin/python -B exporter/business_metrics_exporter.py --config config/monitoring.yaml
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
