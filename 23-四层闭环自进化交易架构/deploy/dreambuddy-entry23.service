[Unit]
Description=Dreambuddy 23-domain entry runner (18 market data -> 23 pipeline -> 22 gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=luke
WorkingDirectory=/home/luke/dreambuddy/23-四层闭环自进化交易架构
Environment="HOME=/home/luke"
Environment=PYTHONUNBUFFERED=1
Environment=EVOLUTION_ENTRY23_ENABLED=on
Environment=EVOLUTION_LOG_ROTATE=external
Environment=EXECUTION_RIGHTS_ENFORCE=1
Environment="EVOLUTION_DSTAR_WAIT_MODE=calibrated"
Environment="EVOLUTION_DSTAR_WAIT_MARGIN=0.30"
# 动态币池：scan_top=6 / max_pool=8，配合 600s 巡检间隔；扫描约 1–3 分钟，
# 池子上限与 LedgerGuards subpool(5) 保持安全余量。
ExecStart=/home/luke/venv-trading/bin/python -m dreambuddy_evolution.scripts.entry_runner --interval 600 --pool-mode dynamic --scan-top 6 --max-pool 8
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=90
StandardOutput=append:/home/luke/logs/yijing/entry23.log
StandardError=append:/home/luke/logs/yijing/entry23.log

[Install]
WantedBy=multi-user.target
