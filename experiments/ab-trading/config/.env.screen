# ==================== 三屏马丁专属配置 ====================
# 继承自 .env.common，可覆盖公共配置

# 包含公共配置
include .env.common

# ==================== 三屏马丁专属配置 ====================

# 策略标识
STRATEGY_ID=screen-martin

# 运行模式
SCREEN_STRATEGY_MODE=auto
SCREEN_AUTO_EXECUTE=true

# 并发持仓限制（三屏马丁专属）
MAX_CONCURRENT_POSITIONS=4

# 代币池（监控的币种）
SCREEN_COINS=BTC,ETH,SOL,ARB,OP,UNI,HYPE,OKB

# 策略参数
SCREEN_VOL_MULT=1.0
SCREEN_MIN_VOL_MULT=0.3
SCREEN_MAX_VOL_MULT=4.0

# LLM 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
SCREEN_LLM_DAILY_LIMIT=12

# 模式切换阈值
SCREEN_SKIP_THRESHOLD=5
SCREEN_LOSS_THRESHOLD=3

# 轮询间隔（秒）
SCREEN_POLL_INTERVAL=3600

# 日志级别
SCREEN_LOG_LEVEL=INFO