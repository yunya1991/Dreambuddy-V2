{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Discovery patterns（同类现象归纳）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "params", "pattern_count", "patterns"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alpha", "min_agree", "min_members", "primary_only"],
      "properties": {
        "alpha": { "type": "number" },
        "min_agree": { "type": "number" },
        "min_members": { "type": "integer", "minimum": 10 },
        "primary_only": { "type": "boolean" }
      }
    },
    "pattern_count": { "type": "integer" },
    "unmapped": { "type": "array", "items": { "type": "string" } },
    "skipped": { "type": "integer" },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern_id",
          "relation_type",
          "family",
          "horizon",
          "direction",
          "support",
          "oppose",
          "significant_n",
          "sign_agreement",
          "bimodal",
          "p_value",
          "p_adj",
          "members",
          "status"
        ],
        "properties": {
          "pattern_id": { "type": "string" },
          "relation_type": { "type": "string", "enum": ["R1", "R2", "R3", "R4", "R5", "R6"] },
          "family": { "type": "string", "enum": ["level", "chg", "mom", "bucket", "other"] },
          "horizon": { "type": "integer" },
          "direction": { "type": "integer", "enum": [-1, 1] },
          "support": { "type": "integer", "minimum": 0 },
          "oppose": { "type": "integer", "minimum": 0 },
          "significant_n": { "type": "integer", "minimum": 0 },
          "sign_agreement": { "type": "number", "minimum": 0, "maximum": 1 },
          "bimodal": { "type": "boolean" },
          "p_value": { "type": "number", "minimum": 0, "maximum": 1 },
          "p_adj": { "type": "number", "minimum": 0, "maximum": 1 },
          "members": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["stable", "candidate"] }
        }
      }
    }
  }
}
