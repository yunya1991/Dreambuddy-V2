{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreambuddy.local/54/contracts/capability_result.schema.json",
  "title": "CapabilityResult",
  "description": "54 能力层统一返回信封（SPEC-54 §5.3）。顶层固定 ok/capability/intent/answer/data/quality/trace_id；quality 只在顶层出现。",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "capability", "intent", "answer", "data", "quality"],
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "status=empty 时为 false，L1 据此转 L2"
    },
    "capability": {
      "type": "string",
      "pattern": "^D-[A-Z]\\d{2}$",
      "description": "能力 ID，必须已在 capability_manifest.yaml 登记"
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "description": "L1 意图，必须与 capability_manifest.yaml 中该能力的 intent 一致"
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "description": "面向用户的一句话；quality.status != good 时必须含降级说明（样本/不足/降级）"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "description": "结构化结果；禁止嵌套 quality / answer",
      "not": {
        "anyOf": [
          {"required": ["quality"]},
          {"required": ["answer"]}
        ]
      },
      "properties": {
        "capabilities": {
          "type": "object",
          "description": "能力块：key=能力 ID，value={gate, methods, ...}",
          "additionalProperties": {
            "type": "object",
            "required": ["gate", "methods"],
            "properties": {
              "gate": {
                "enum": [
                  "ok",
                  "partial",
                  "degraded",
                  "insufficient_samples",
                  "insufficient_history",
                  "no_data"
                ],
                "description": "能力级门禁：ok=完整；partial=部分窗口/分支不可算但保留结果；degraded=计算成功但结果降级（如弱周期）；其余为样本/历史/数据不足。方法级 gate 另有 skipped/calculation_failed/empty，不在本枚举内。"
              },
              "methods": {
                "type": "array",
                "items": {"type": "string", "pattern": "^[A-Z]{1,2}\\d{2}$"},
                "minItems": 1
              },
              "reason": {"type": "string"}
            }
          }
        },
        "params": {"type": "object"},
        "symbol": {"type": ["string", "null"]},
        "pair": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
        "name": {"type": ["string", "null"], "description": "资产/口径显示名"},
        "as_of": {"type": ["string", "null"], "description": "数据时点（UTC）"},
        "window_days": {"type": ["integer", "null"], "minimum": 1},
        "source": {"type": ["string", "null"], "description": "数据来源标识"},
        "items": {"type": "array", "description": "列表型结果的明细项"},
        "notes": {"type": ["string", "array", "null"], "description": "口径说明/告警"},
        "assets": {"type": ["object", "array", "null"], "description": "资产池/分组映射"},
        "lights": {
          "type": "array",
          "description": "D-E19 轴级点亮事实（TD §7.5 B-1 冻结行字段）：图表层交给信号层的机器制品，非图种；每行一个标的。",
          "items": {"$ref": "#/$defs/lights_row"}
        },
        "visual": {"$ref": "#/$defs/visual"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sample_n", "is_stale", "degraded_reason"],
      "properties": {
        "status": {"enum": ["good", "partial", "empty"]},
        "sample_n": {"type": "integer", "minimum": 0},
        "span": {
          "type": ["array", "null"],
          "items": {"type": "string"},
          "minItems": 2,
          "maxItems": 2,
          "description": "[首日, 末日]，UTC ISO 日期"
        },
        "is_stale": {"type": "boolean"},
        "degraded_reason": {
          "type": ["string", "null"],
          "description": "status != good 时必填：insufficient_samples / no_history / stale_data / seasonality_depth_lt_5y 等"
        },
        "sources": {"type": "array", "items": {"type": "string"}},
        "snapshot_at": {
          "type": ["string", "null"],
          "description": "数据快照时点（UTC）；由 19-DAL 快照层提供，能力层不得自行推断填充（K-12）"
        },
        "missing_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "align_method": {"type": ["string", "null"]},
        "timezone": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["partial", "empty"]}}},
          "then": {"required": ["degraded_reason"], "properties": {"degraded_reason": {"type": "string"}}}
        }
      ]
    },
    "trace_id": {"type": ["string", "null"]}
  },
  "$defs": {
    "visual": {
      "type": "object",
      "description": "SPEC-54-统计图表化能力 §4：后端产规格、前端零统计；每信封最多 1 个。",
      "additionalProperties": false,
      "required": [
        "kind",
        "spec_version",
        "title",
        "source_capability",
        "n_scope",
        "dataset",
        "encodings",
        "quality_ref",
        "caveat",
        "truncated"
      ],
      "properties": {
        "kind": {"enum": ["table", "series", "matrix", "tree", "graph"]},
        "spec_version": {"const": "1.0"},
        "title": {"type": "string", "minLength": 1, "maxLength": 60},
        "source_capability": {"type": "string", "pattern": "^(D-[A-Z]\\d{2}|T[1-4])$"},
        "n_scope": {"enum": ["global", "per_row", "per_cell"]},
        "dataset": {"type": "object"},
        "encodings": {"type": "object"},
        "annotations": {"type": "object"},
        "quality_ref": {"const": "quality"},
        "caveat": {"type": "string", "minLength": 1},
        "truncated": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "table"}}},
          "then": {
            "required": ["dataset"],
            "properties": {
              "dataset": {
                "type": "object",
                "required": ["columns", "rows"],
                "additionalProperties": false,
                "properties": {
                  "columns": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["key", "label", "type"],
                      "properties": {
                        "key": {"type": "string"},
                        "label": {"type": "string"},
                        "type": {"enum": ["string", "number", "date", "percent"]}
                      }
                    }
                  },
                  "rows": {"type": "array", "maxItems": 500, "items": {"type": "object"}},
                  "groups": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {"type": "string"},
                    "description": "可按其分组的列 key 列表（SPEC-54 §4.2）"
                  }
                }
              }
            }
          }
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "series"}}},
          "then": {
            "properties": {
              "dataset": {
                "type": "object",
                "required": ["points"],
                "additionalProperties": false,
                "properties": {
                  "points": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["x", "y"],
                      "properties": {
                        "x": {"type": ["string", "number"]},
                        "y": {"type": "number"},
                        "smoothed": {"type": ["number", "null"]},
                        "upper": {"type": ["number", "null"]},
                        "lower": {"type": ["number", "null"]},
                        "agg": {"type": ["number", "null"]},
                        "members": {"type": "object"},
                        "coverage_ratio": {"type": ["number", "null"]},
                        "partial_members": {"type": "boolean"},
                        "extra": {"type": "object"}
                      }
                    }
                  },
                  "meta": {
                    "type": "object",
                    "required": ["smoothing", "unit", "n"],
                    "properties": {
                      "smoothing": {
                        "type": "object",
                        "required": ["method", "window"],
                        "properties": {
                          "method": {"type": "string"},
                          "window": {"type": ["integer", "number"]}
                        }
                      },
                      "unit": {"type": "string"},
                      "n": {"type": "integer", "minimum": 0}
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "matrix"}}},
          "then": {
            "properties": {
              "dataset": {
                "type": "object",
                "required": ["row_labels", "col_labels", "values"],
                "additionalProperties": false,
                "properties": {
                  "row_labels": {"type": "array", "maxItems": 20, "items": {"type": "string"}},
                  "col_labels": {"type": "array", "maxItems": 20, "items": {"type": "string"}},
                  "values": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "array",
                      "maxItems": 20,
                      "items": {"type": ["number", "null"]}
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "tree"}}},
          "then": {
            "properties": {
              "dataset": {
                "type": "object",
                "required": ["root"],
                "additionalProperties": false,
                "properties": {"root": {"type": "object"}}
              }
            }
          }
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "graph"}}},
          "then": {
            "properties": {
              "dataset": {
                "type": "object",
                "required": ["nodes", "edges"],
                "additionalProperties": false,
                "properties": {
                  "nodes": {
                    "type": "array",
                    "maxItems": 300,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["id", "label"],
                      "properties": {
                        "id": {"type": "string"},
                        "label": {"type": "string"},
                        "group": {"type": ["string", "null"]}
                      }
                    }
                  },
                  "edges": {
                    "type": "array",
                    "maxItems": 2000,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["src", "dst"],
                      "properties": {
                        "src": {"type": "string"},
                        "dst": {"type": "string"},
                        "kind": {"enum": ["corr", "lead_lag", "same_direction", "flow"]},
                        "weight": {"type": ["number", "null"]},
                        "p_adj": {"type": ["number", "null"]}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "lights_row": {
      "type": "object",
      "additionalProperties": false,
      "description": "D-E19 单标的点亮行（TD §7.5 B-1；G-IF1 冻结结构，G-IF2 冻结四轴强度与阈值消费口径）。",
      "required": [
        "symbol",
        "class",
        "as_of",
        "axes",
        "strength",
        "summary",
        "light_weights_hash",
        "n",
        "min_rows",
        "status",
        "flags"
      ],
      "properties": {
        "symbol": {"type": "string"},
        "class": {"type": "string"},
        "as_of": {"type": ["string", "null"], "description": "透传入参，无时区约束（B-6）"},
        "axes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trend", "inertia", "cycle", "foresight"],
          "properties": {
            "trend": {"$ref": "#/$defs/lights_axis"},
            "inertia": {"$ref": "#/$defs/lights_axis"},
            "cycle": {"$ref": "#/$defs/lights_axis"},
            "foresight": {"$ref": "#/$defs/lights_axis"}
          }
        },
        "strength": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lit_n", "warm_n", "conflict_n", "unavailable_n"],
          "properties": {
            "lit_n": {"type": "integer", "minimum": 0},
            "warm_n": {"type": "integer", "minimum": 0},
            "conflict_n": {"type": "integer", "minimum": 0},
            "unavailable_n": {"type": "integer", "minimum": 0}
          }
        },
        "light_weights_hash": {"type": "string", "minLength": 1},
        "n": {"type": "integer", "minimum": 0},
        "min_rows": {"type": "integer", "minimum": 1},
        "status": {"enum": ["available", "partial", "unavailable"]},
        "flags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "lights_axis": {
      "type": "object",
      "additionalProperties": false,
      "description": "D-E19 单轴事实：只表达统计一致性强度，不表达方向（LT-G1）。",
      "required": ["state", "strength", "bucket", "evidence", "flags"],
      "properties": {
        "state": {"enum": ["lit", "warm", "dim", "conflict", "unavailable"]},
        "strength": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "bucket": {"enum": ["high", "mid", "low", "none"]},
        "evidence": {"type": "object"},
        "flags": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
