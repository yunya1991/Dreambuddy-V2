+
+def _prices(n=400, seed=5, drift=0.0005, vol=0.02):
+    rng = random.Random(seed)
+    out, px = [], 100.0
+    for _ in range(n):
+        px *= 1.0 + rng.gauss(drift, vol)
+        out.append(px)
+    return out
+
+
+def _dates(n=400, start=datetime.date(2024, 1, 1)):
+    return [(start + datetime.timedelta(days=i)).isoformat() for i in range(n)]
+
+
+# ---------------- manifest ----------------
+
+
+def test_manifest_loads_and_validates():
+    m = manifest()
+    assert m.version >= 1
+    ids = [cap.id for cap in m.capabilities]
+    assert len(ids) == len(set(ids))
+    assert {"D-E02", "D-E03", "D-E05", "D-E06", "D-E07", "D-E08", "D-E10", "D-E11"} <= set(ids)
+    for cap in m.capabilities:
+        assert cap.executor.split(".")[-1] in {
+            "seasonality", "correlation", "state_transition", "conditional_ic", "drawdown",
+            "percentile_forward",
+        }
+
+
+def test_manifest_every_declared_capability_is_runnable():
+    assert set(supported()) == {cap.id for cap in manifest().capabilities}
+
+
+def test_manifest_rejects_unimplemented_method():
+    bad = Manifest(version=1, updated="", capabilities=(
+        Capability(id="D-E99", intent="x", mode="deterministic", data_scope=("market.candles",),
+                   executor="capabilities.stats.drawdown", methods=("T23",), min_n=10),
+    ))
+    with pytest.raises(ManifestError):
+        validate(bad)
+
+
+def test_manifest_rejects_min_n_below_method_gate():
+    bad = Manifest(version=1, updated="", capabilities=(
+        Capability(id="D-E98", intent="x", mode="deterministic", data_scope=("market.candles",),
+                   executor="capabilities.stats.conditional_ic", methods=("B13",), min_n=10),
+    ))
+    with pytest.raises(ManifestError):
+        validate(bad)
+
+
+def test_manifest_rejects_mode_mix_within_intent():
+    caps = (
+        Capability(id="D-E90", intent="correlation_query", mode="deterministic",
+                   data_scope=("market.candles",), executor="capabilities.stats.correlation",
+                   methods=("M01",), min_n=60),
+        Capability(id="D-E91", intent="correlation_query", mode="gated",
+                   data_scope=("market.candles",), executor="capabilities.stats.correlation",
+                   methods=("M01",), min_n=60),
+    )
+    with pytest.raises(ManifestError):
+        validate(Manifest(version=1, updated="", capabilities=caps))
