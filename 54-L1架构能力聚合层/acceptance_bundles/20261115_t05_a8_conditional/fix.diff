+# ---------------- 信封 ----------------
+
+
+def test_envelope_rejects_empty_answer():
+    with pytest.raises(ValueError):
+        build(capability="D-E10", intent="drawdown_query", answer="  ",
+              data={}, quality_block=quality_for(10, min_n=1))
