# 复制到 /etc/skillhub-audit/audit.env（chmod 640，owner root:skillhub）
PORT=8788
HOST=127.0.0.1
DB_PATH=/var/lib/skillhub-audit/orders.db
PRICE_YUAN=0.99
GOODS_NAME=Skill 上架体检报告
SELLER_NAME=DreamBuddy
PAY_WINDOW_MINUTES=30

# 支付宝开放平台自研应用
ALIPAY_APP_ID=
# PKCS#1 或 PKCS#8 裸 Base64，或私钥文件绝对路径（推荐文件，权限 600）
ALIPAY_PRIVATE_KEY=/etc/skillhub-audit/app_private_key.txt
ALIPAY_PUBLIC_KEY=/etc/skillhub-audit/alipay_public_key.txt
# 商家 2088 开头 PID
ALIPAY_SELLER_ID=
# 沙箱固定 api_mock_service_id；生产替换为服务市场注册返回的 API 开头 serviceId
ALIPAY_SERVICE_ID=api_mock_service_id
# 沙箱：https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 生产：https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# 认知管家体检资源（/api/cogsteward）；不填 COGSTEWARD_PRICE_YUAN 则不挂载
COGSTEWARD_PRICE_YUAN=0.99
COGSTEWARD_RESOURCE_ID=/api/cogsteward
COGSTEWARD_GOODS_NAME=认知管家·工作区体检报告
# 留空则复用 ALIPAY_SERVICE_ID
COGSTEWARD_ALIPAY_SERVICE_ID=
