{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neodrm.local/59/contracts/component.schema.json",
  "title": "通用组件元数据（components/<name>/component.yaml）",
  "description": "依据 SPEC-通用组件管理-架构重构 v0.2 §5.1。每个组件目录必须有且仅有一份 component.yaml；version 必须与 skill/SKILL.md frontmatter 的 version 完全一致（由 tools/check_boundaries.py G5 校验）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "family",
    "lifecycle",
    "entrypoints",
    "kernel_deps",
    "output_contract",
    "tests"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "唯一标识，小写连字符，必须与所在目录名一致"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "description": "对外展示名（可中文），仅用于 INDEX 与分发产物"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "SemVer；必须与 skill/SKILL.md frontmatter 一致，否则 G5 失败"
    },
    "family": {
      "enum": ["cogsteward", "market-data", "event-context", "market-facts", "reservation-assist", "site-blog", "dal-data", "news-monitor"],
      "description": "商品族，决定构建变体与共用契约 profile"
    },
    "lifecycle": {
      "enum": ["draft", "beta", "active", "deprecated", "retired"],
      "description": "生命周期；draft → beta → active → deprecated → retired（判据见 tools/lifecycle.py）"
    },
    "deprecated": {
      "type": "object",
      "additionalProperties": false,
      "description": "弃用信息；lifecycle=deprecated/retired 时必填（G8 校验）",
      "required": ["at", "sunset_at"],
      "properties": {
        "at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "宣布弃用日期"
        },
        "sunset_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "停止支持日期；retired 必须已到期"
        },
        "replacement": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "替代组件名"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "弃用原因（没有替代组件时必填）"
        }
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 200,
      "description": "一句话能力描述，写入生成的 INDEX 表"
    },
    "skill_dir": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+$",
      "default": "skill",
      "description": "打包源目录名，默认 skill；该目录内容才允许进分发物"
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^scripts/[A-Za-z0-9._/-]+\\.py$"
      },
      "description": "对外入口脚本，相对 skill/ 的路径"
    },
    "actions": {
      "type": "array",
      "description": "可被 dreambuddy 调用的动作清单（只读优先，供统一 CLI 编排）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "script", "safety"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "maxLength": 200
          },
          "when_to_use": {
            "type": "string",
            "maxLength": 160
          },
          "not_for": {
            "type": "string",
            "maxLength": 160
          },
          "script": {
            "type": "string",
            "pattern": "^scripts/[A-Za-z0-9._/-]+\\.py$"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "safety": {
            "enum": ["read", "write", "ui", "irreversible"],
            "description": "read=只读；write=本地/外部写入；ui=手机 UI 副作用（等同写入，需授权）；irreversible=支付/提交/发布（禁止暴露 MCP）"
          },
          "output": {
            "enum": ["json", "text"],
            "default": "text",
            "description": "调用时是否强制追加 --json 并输出结构化结果；MCP 工具必须为 json"
          },
          "params": {
            "type": "array",
            "description": "动作入参声明（唯一源）：同时生成 MCP inputSchema 与 Skill 参数表；未声明则只能通过 CLI 透传",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "flag": {
                  "type": ["string", "null"],
                  "pattern": "^--[a-z][a-z0-9-]*$",
                  "description": "命令行 flag；省略或 null 表示位置参数"
                },
                "type": {
                  "enum": ["string", "integer", "number", "boolean", "array"]
                },
                "required": {
                  "type": "boolean",
                  "default": false
                },
                "default": {},
                "enum": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "description": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            }
          },
          "mcp": {
            "type": "object",
            "additionalProperties": false,
            "description": "MCP 投影开关；expose=true 才会生成工具",
            "properties": {
              "expose": {
                "type": "boolean",
                "default": false
              },
              "tier": {
                "enum": ["hot", "extended"],
                "default": "extended",
                "description": "hot 进默认工具集，extended 需 --profile all"
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "description": "工具名覆盖；默认 <component>_<action>"
              }
            }
          }
        }
      }
    },
    "kernel_deps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["endpoint", "handoff", "pay_gate", "headers"]
      },
      "description": "只允许引用 kernel/ 下模块名；源码期不得直接 import kernel，由构建期内联"
    },
    "output_contract": {
      "type": "string",
      "pattern": "^(data|handoff|cogsteward|reservation)\\.v1$",
      "description": "output.schema.json 中的 profile 名；不得私自定义新 profile"
    },
    "products": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "description": "对应的 products/<name>.yaml；无分发变体时为空数组"
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir", "entry"],
      "properties": {
        "dir": {
          "type": "string",
          "pattern": "^tests/?$"
        },
        "entry": {
          "type": "string",
          "minLength": 1,
          "description": "可直接在组件根执行的测试命令"
        }
      }
    },
    "docs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "组件文档相对路径清单（不进分发包）"
    }
  }
}
