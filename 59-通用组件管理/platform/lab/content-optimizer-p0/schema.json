{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "content-optimizer P0 样本",
  "description": "P0-A/P0-B 统一样本契约；缺失一律 null，不用 0 代替。字段口径见 SPEC-20261124 §6.2。",
  "type": "object",
  "additionalProperties": false,
  "required": ["sample_id", "platform", "source_type", "collected_at"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "platform": {"enum": ["xiaohongshu", "douyin"]},
    "source_type": {"enum": ["public", "own"]},
    "url_hash": {"type": ["string", "null"], "description": "原始 URL 的 sha256 前 16 位；不存原始 URL"},
    "query": {"type": ["string", "null"]},
    "rank_bucket": {"enum": ["1-10", "11-30", "31-50", "unknown"]},
    "collected_at": {"type": "string", "format": "date-time"},
    "collector": {"type": ["string", "null"], "description": "scout / manual / creator_export"},
    "author_followers_bucket": {"enum": ["<1k", "1k-1w", "1w-10w", ">=10w", "unknown"]},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "publish_hour": {"type": ["integer", "null"], "minimum": 0, "maximum": 23},
    "weekday": {"type": ["integer", "null"], "minimum": 1, "maximum": 7},
    "title": {"type": ["string", "null"], "maxLength": 100},
    "title_len": {"type": ["integer", "null"], "minimum": 0},
    "title_pattern": {"enum": ["number", "question", "contrast", "benefit", "emotion", "statement", "unknown"]},
    "body_len": {"type": ["integer", "null"], "minimum": 0},
    "topic_count": {"type": ["integer", "null"], "minimum": 0},
    "hashtag_count": {"type": ["integer", "null"], "minimum": 0},
    "cover_type": {"enum": ["text", "portrait", "chart", "screenshot", "solid", "unknown"]},
    "media_type": {"enum": ["image", "video", "unknown"]},
    "duration_sec": {"type": ["number", "null"], "minimum": 0},
    "first3s_text_present": {"type": ["boolean", "null"]},
    "likes": {"type": ["integer", "null"], "minimum": 0},
    "saves": {"type": ["integer", "null"], "minimum": 0},
    "comments": {"type": ["integer", "null"], "minimum": 0},
    "shares": {"type": ["integer", "null"], "minimum": 0},
    "metrics_at": {"type": ["string", "null"], "format": "date-time"},
    "impressions": {"type": ["integer", "null"], "minimum": 0},
    "views": {"type": ["integer", "null"], "minimum": 0},
    "cover_ctr": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "avg_watch_sec": {"type": ["number", "null"], "minimum": 0},
    "completion_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "two_sec_bounce": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "follows": {"type": ["integer", "null"], "minimum": 0},
    "missing_flags": {"type": "array", "items": {"type": "string"}},
    "outlier_flags": {"type": "array", "items": {"type": "string"}},
    "is_censored": {"type": "boolean", "default": false}
  }
}
