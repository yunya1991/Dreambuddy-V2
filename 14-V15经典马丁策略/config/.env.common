# ==================== 公共配置 ====================
# 以下配置对三屏马丁和马丁策略(V15-CT)共用

# OKX 实盘账户配置（马丁策略专用）
# PROP-20260816C: 凭据已迁移至 .env.local（不入库），经 include 加载
include .env.local

# OKX 交易环境设置（实盘）
OKX_BASE_URL=https://www.okx.com
OKX_SIMULATED=false
OKX_DRY_RUN=false

# 资金管理配置（共用资金池）
TOTAL_BUDGET=120
LEVERAGE=5.0
MIN_MARGIN_USD=10

# 马丁策略基础参数（共用）
# 实盘测试版本：允许最多 4 次加仓 = 总 5 单（首单+4档加仓）
MAX_ADDONS_PER_POSITION=4
ADDON_PCT=0.08
# 底仓22%（现货思维：5x杠杆下底仓名义敞口=预算×110%）
# 注：此前 .env.common 误设为 0.05 导致底仓极小，已恢复为代码默认值
BASE_POSITION_PCT=0.22
# 加仓金字塔结构（越跌加仓越大，经典马丁）
ADDON1_PCT=0.05
ADDON2_PCT=0.10
ADDON3_PCT=0.20
ADDON4_PCT=0.35  # 最深档黑天鹅加仓（5单结构末端）
MAX_POSITION_PCT=0.60
BASE_TP_PCT=0.04

# ==================== 超时止盈信号排名配置 ====================
# 超时盈利时，先做信号排名对比（当前币种 vs 其他未持仓币种的 confidence）
# - 当前币种信号最强 → 延长超时窗口继续持有（避免频繁换仓）
# - 存在更强币种 → 平仓止盈释放仓位（下一轮 poll 自然开新仓）
# V15_TIME_EXIT_EXTENSION_STEP_HOURS: 每次延长窗口的步长（默认 6h）
# V15_TIME_EXIT_MAX_EXTENSION_HOURS: 累计延长上限（默认 24h，超过则强制平仓）
V15_TIME_EXIT_EXTENSION_STEP_HOURS=6
V15_TIME_EXIT_MAX_EXTENSION_HOURS=24

# ==================== 币种池配置 ====================
# V15_COINS: 马丁策略交易币种池（SymbolMapper 会过滤出 OKX 支持的合约）
# 含：主流币 + 平台币 + 美股代币 + 贵金属
V15_COINS=BTC,ETH,SOL,BNB,OKB,UNI,HYPE,PUMP,MU,SKHYNIX,GOOGL,NVDA,AMZN,SNDK,SPCX,LINK,XAU,XAG

# ==================== Phase D: AI 闸门（影子模式） ====================
# V15_AI_ENABLED=true: 启用 PhaseDGateway（G-D1 跳过开仓 / G-D2 缩减加仓档 / G-D3 放宽时机评分）
# V15_AI_SHADOW=true:  影子模式——只打印 AI 决策日志，不实际生效（实盘行为与基线字节等价）
# 观察周期：2-4 周，确认 S_bt ≥ 1.20 后可将 SHADOW 改为 false 正式启用
V15_AI_ENABLED=true
V15_AI_SHADOW=false

# ==================== Phase E: PPO-LSTM 强化学习（开发中，默认关闭） ====================
# V15_AI_PHASE_E_ENABLED=true: 启用 PhaseEGateway（PPO 动作 + DS 风控盾）
# 默认 false=完全不运行 Phase E，保证与基线字节级等价
# 开发完成后需通过 §3.2 双验证才能改为 true
V15_AI_PHASE_E_ENABLED=true
V15_AI_PHASE_E_MODEL_PATH=data/phase_e_models_v1/ppo_lstm.pt