# ==================== 马丁策略(V15-CT)专属配置 ====================
# 资金管理器增强版：贝叶斯优化 + 三屏趋势过滤 + 分层加仓
# 继承自 .env.common，可覆盖公共配置

# 包含公共配置
include .env.common

# ==================== 马丁策略专属配置 ====================

# 策略标识
STRATEGY_ID=v15-ct

# 运行模式
V15CT_MODE=auto
V15CT_AUTO_EXECUTE=true

# ── 资金管理（贝叶斯优化版：底仓现货思维 + 黑天鹅加仓）──
# 底仓22% + 5x杠杆 ≈ 110%现货敞口（平时略占优，有止盈机制）
TOTAL_BUDGET=100
BASE_POSITION_PCT=0.22
LEVERAGE=5.0
MAX_CONCURRENT_POSITIONS=6
MAX_ADDONS_PER_POSITION=3

# 加仓资金分配（贝叶斯优化结果）
ADDON_PCT=0.08
ADDON1_PCT=0.20
ADDON2_PCT=0.05
ADDON3_PCT=0.10
MAX_POSITION_PCT=0.60
MIN_MARGIN_USD=5

# ── 三屏趋势过滤（已禁用，后期引入三屏空头趋势信号系统）──
# none: 不过滤 | both_bear: 周线+日线都看空时禁止做多 | weekly_bear: 仅周线看空
# 注：动态止损线（日线/周线MA200、EMA200）已提供足够保护，无需额外开仓过滤
TREND_FILTER_MODE=none
TREND_FILTER_PERIOD=200

# 代币池（监控的币种）
V15CT_COINS=BTC,ETH,SOL,BNB,XRP,ADA,DOGE,LTC,LINK,AVAX,DOT,UNI,NEAR,APT,ARB,OP,INJ,SUI,SEI,TIA,AAVE,COMP,CRV,DYDX,LDO,PEPE,SAND,SHIB,STX,SUSHI,WLD,ZEC,OKB,HYPE

# 策略参数
V15CT_VOL_MULT=1.875
V15CT_MIN_VOL_MULT=0.3
V15CT_MAX_VOL_MULT=4.0

# 入场条件
V15CT_RSI_LOW=30
V15CT_RSI_HIGH=70
V15CT_FIB_ZONE=IN_ZONE
V15CT_TREND_CONFIDENCE=0.5
V15CT_CONFIDENCE_THRESHOLD=30

# 测试模式（降低入场标准用于系统验证）
V15CT_TEST_MODE=true

# 止盈参数（BTC基准4%，其他币种按波动率自动放大）
BASE_TP_PCT=0.04
BASE_ADDON_PCT=0.08

# 轮询间隔（秒）
V15CT_POLL_INTERVAL=3600

# 风控阈值
V15CT_DAILY_LOSS_LIMIT=-50
V15CT_MAX_CONSECUTIVE_LOSSES=5

# ── 超时触发经典离场系统（最佳持仓时间）──
# 底仓最大持仓时间（小时），超时后触发经典离场评估
V15_MAX_BASE_HOLDING_HOURS=48
# 加仓后最大持仓时间（小时），超时后触发经典离场评估
V15_MAX_POST_ADDON_HOURS=24
# 黑天鹅反弹黄金窗口（小时），窗口内不触发评估，让反弹充分发展
V15_GOLDEN_WINDOW_HOURS=12

# 日志级别
V15CT_LOG_LEVEL=INFO
