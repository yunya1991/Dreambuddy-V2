# V15 叠加层配置 — 与 data/v15_final_deployment.json active_config 对齐
# PROP-20260810-V15CFG（2026-08-10 用户批准）
# V9 红线参数在 .env.common，本文件仅 V15 叠加层，不得写入 V9 参数
V15_ALLOW_SHORT=false
V15_RISK_GATE_ENABLED=true
V15_MAX_BASE_HOLDING_HOURS=29.9
V15_MAX_POST_ADDON_HOURS=37.7
V15_GOLDEN_WINDOW_HOURS=11.1
V15_COOLDOWN_HOURS=48
MAX_CONCURRENT_POSITIONS=3

# 资产类型配置（决定方向控制模式）
# crypto: 加密货币 → BTC风向标智能模式（§16）
# stock:  美股/非加密资产 → 旧版MA200止损+DirectionGate
# PROP-20260816C（2026-08-16 用户批准）: OKB 移出币池（无 HL perp）
V15_ASSET_TYPES=BTC:crypto,ETH:crypto,SOL:crypto,ARB:crypto,OP:crypto,UNI:crypto,HYPE:crypto

# PROP-20260816C: V15 币池（7币，与 HL 执行层对齐；OKB 无 HL perp 移除）
# 移除后 BTC 风向标/相关性/拥挤度检查不再因拉取 OKB 数据失败而退化
V15_COINS=BTC,ETH,SOL,ARB,OP,UNI,HYPE

# ==================== PROP-20260816C: 数据源/执行层切换（用户批准 2026-08-16） ====================
# 开关为机器相关配置，不入库（防止用户 Mac 拉取后实盘被切 paper）：
# - 腾讯云本机：config/.env.local 中设置 V15_DATA_SOURCE=hyperliquid + V15_EXECUTION=paper
#   （经 .env.common 的 include .env.local 加载；文件不存在时静默跳过）
# - 用户 Mac：无 .env.local → 留空默认 = OKX 数据源 + OKX 实盘客户端（行为不变）
# 取值说明：V15_DATA_SOURCE: hyperliquid|空(=okx)；V15_EXECUTION: paper|空(=okx)
