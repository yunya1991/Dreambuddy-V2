# ==================== V15经典马丁策略专属配置 ====================
# 注: 公共配置(.env.common)由 config_loader.load_config() 自动合并加载
# orchestrator.py 使用 python-dotenv 加载本文件, 不支持 include 语法
# ==================== 马丁策略专属配置 ====================

# 策略标识
STRATEGY_ID=v15

# 运行模式
V15_MODE=auto
V15_AUTO_EXECUTE=true

# 并发持仓限制（马丁策略专属）
MAX_CONCURRENT_POSITIONS=3

# 最小保证金（小账户适配）
MIN_MARGIN_USD=5

# 代币池（监控的币种）— 强势代币候选
# 资产类别: crypto(加密货币) / stock(美股个股永续)
# 加密强势: BTC,ETH,SOL,UNI
# 美股强势: MU(美光),SKHYNIX(海力士) — OKX 股票永续合约
# 后续可补充美股代币(NVDA/TSLA等)和加密代币
# ── 马丁风控过滤：剔除小市值和新币，避免黑天鹅 ──
V15_COINS=UNI,BTC,ETH,SOL,MU,SKHYNIX

# ── 马丁策略币种风控参数 ──
# 最低市值等级: large(仅大市值) / mid(大+中市值，推荐) / small(全部)
V15_MARTIN_MIN_TIER=mid
# 最小上线天数: 新币暴涨暴跌风险大，要求至少1年历史数据
V15_MARTIN_MIN_HISTORY_DAYS=365

# 策略参数
V15_VOL_MULT=1.875
V15_MIN_VOL_MULT=0.3
V15_MAX_VOL_MULT=4.0

# 入场条件
V15_RSI_LOW=30
V15_RSI_HIGH=70
V15_FIB_ZONE=IN_ZONE
V15_TREND_CONFIDENCE=0.5

# 止盈
V15_TAKE_PROFIT_PCT=0.04

# 轮询间隔（秒）
V15_POLL_INTERVAL=3600

# 杠杆倍数（固定5x，不参与贝叶斯优化）
LEVERAGE=5.0

# 风控阈值
V15_DAILY_LOSS_LIMIT=-50
# 实盘风控：连续亏损N笔触发48小时冷却暂停+飞书告警（用户要求6笔）
V15_MAX_CONSECUTIVE_LOSSES=6
# 单次轮询/全局最多开仓数（用户要求3笔，并发持仓限制）
MAX_CONCURRENT_POSITIONS=3
# 启用交易门禁（true=实盘阻断模式，false=影子模式仅记录）
V15_RISK_GATE_ENABLED=true
# 连续亏损触发后的冷却暂停时长（小时，用户要求48h）
V15_COOLDOWN_HOURS=48
# 飞书告警启用（false=仅本地日志，true=推送飞书）
V15_FEISHU_ALERT_ENABLED=true

# ── 三屏趋势过滤（已禁用，后期引入三屏空头趋势信号系统）──
# none: 不过滤 | both_bear: 周线+日线都看空时禁止做多 | weekly_bear: 仅周线看空
# 注：动态止损线（日线/周线MA200、EMA200）已提供足够保护，无需额外开仓过滤
TREND_FILTER_MODE=none
TREND_FILTER_PERIOD=200

# ── 多空方向控制（DirectionGate v2: MA200 + BTC风向标智能模式）──
# false: 只做多（向后兼容）
# true:  启用做空机制，智能选择最优方向控制策略
#   - BTC等超大市值币: 自身MA200止损 + DirectionGate（更精准）
#   - 其他市值币种: BTC风向标3日确认模式（避免山寨币MA200噪声）
#     • BTC连续3日收盘价低于日MA200 → 平掉多仓，全局允许做空
#     • BTC价格触及周MA200 → 平掉空仓，强制做多（下跌末端风险高）
#     • BTC在日MA200上方 → 只做多（震荡+多头行情，做多占多数）
V15_ALLOW_SHORT=true

# BTC风向标模式（智能模式下非BTC币种默认启用）
# confirm_days: 跌破MA200确认天数（默认3日，稳健模式）
# short_only: SHORT_ALLOWED状态下是否只允许做空（默认true=只做空，避免下跌趋势中做多风险）
BTC_WINDVANE_ENABLED=true
BTC_WINDVANE_CONFIRM_DAYS=3
BTC_WINDVANE_SHORT_ONLY=true

# Elder-ray日线强度资金调度（贝叶斯优化最优范围：0.9x - 1.5x基线资金）
# 不利势能减弱/反弹强度高时仓位更大，趋势强劲不利时仓位更小
# 回测验证：整体收益+6.05% → 贝叶斯优化后+52.62%
ELDER_RAY_ENABLED=true
ELDER_RAY_FLOOR=0.9
ELDER_RAY_CEIL=1.5

# 贝叶斯优化最优参数（2026-07-16）
TRAILING_ATR_MULT=1.0
TRAILING_START_RATIO=0.8
MAX_BASE_HOLDING_HOURS=29.9
MAX_POST_ADDON_HOURS=37.7
GOLDEN_WINDOW_HOURS=11.1

# ── 贝叶斯优化自动调度（连亏触发+每月轮询+冷却期+自动回退）──
# 连续亏损N笔触发优化（默认3笔，事件驱动）
BAYESIAN_OPT_LOSS_STREAK_TRIGGER=3
# 每周定时触发（默认false，避免过拟合和版本管理压力）
BAYESIAN_OPT_WEEKLY=false
# 每月定时触发（默认true，周期驱动）
BAYESIAN_OPT_MONTHLY=true
# 优化后收益需比基线高N%才采用，否则回退基线（默认2%）
BAYESIAN_OPT_MIN_IMPROVE_PCT=2.0
# 冷却期：距上次优化N小时内不重复触发（默认24小时，防止短时间频繁优化）
BAYESIAN_OPT_COOLDOWN_HOURS=24

# 超大市值币种列表（使用自身MA200止损+DirectionGate，不使用BTC风向标）
LARGE_CAP_COINS=BTC

# ── 反弹检测器过滤（开仓二次过滤）──
# true: 启用反弹信号检测，只有触发反弹信号时才允许开仓
# false: 禁用，仅作为监控参考
BOUNCE_FILTER_ENABLED=true
BOUNCE_MIN_SIGNALS=1

# ── 超时触发经典离场系统（最佳持仓时间）──
V15_MAX_BASE_HOLDING_HOURS=48
V15_MAX_POST_ADDON_HOURS=24
V15_GOLDEN_WINDOW_HOURS=12

# ── 移动止盈（Trailing TP）──
# true: 启用移动止盈，浮盈达80%启动，从峰值回撤N×ATR止盈（参数从active_params.json加载）
# false: 禁用，仅使用固定止盈
V15_USE_TRAILING_TP=true

# 日志级别
V15_LOG_LEVEL=INFO
