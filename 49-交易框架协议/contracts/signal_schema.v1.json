{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "signal_schema.v1.json",
  "title": "SignalSchema v1",
  "description": "交易域候选/输出信号统一契约（49-交易框架协议）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signal_id",
    "source",
    "ts",
    "symbol",
    "direction",
    "confidence",
    "horizon",
    "risk_exposure_hint",
    "expires_at",
    "mode"
  ],
  "properties": {
    "signal_id": { "type": "string", "minLength": 1 },
    "source": {
      "type": "string",
      "enum": [
        "11-bcrm",
        "bdsm",
        "11-bdsm",
        "11-event-arbitrage",
        "11-washout",
        "29-event",
        "40-cycle",
        "strategic_extension",
        "23-contradiction",
        "23-evolution",
        "11-strategic"
      ]
    },
    "ts": { "type": "string" },
    "symbol": {
      "type": "string",
      "pattern": "^([A-Z0-9]+-USDT-SWAP|MACRO)$"
    },
    "direction": { "type": "string", "enum": ["long", "short", "neutral"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "horizon": { "type": "string", "enum": ["minutes", "hours", "days", "weeks"] },
    "risk_exposure_hint": { "type": "number", "minimum": 0, "maximum": 1 },
    "expires_at": { "type": "string" },
    "mode": { "type": "string", "enum": ["live", "paper", "shadow"] },
    "shadow": { "type": "boolean" },
    "constraint_id": { "type": "string" },
    "constraint_applied_at": { "type": "string" },
    "payload": { "type": "object" }
  }
}