{
  "jobs": [
    {
      "id": "yijing_monitor",
      "name": "易经推理监控",
      "command": "/opt/anaconda3/bin/python3 -m scripts.memory_l4.yijing_monitor",
      "cron": "0 */3 * * *",
      "enabled": true,
      "description": "每3小时运行一次，检查系统健康状态、执行自进化、推送飞书告警"
    },
    {
      "id": "yijing_health_check",
      "name": "易经推理健康检查",
      "command": "/opt/anaconda3/bin/python3 -m scripts.memory_l4.yijing_monitor --check-only",
      "cron": "0 */1 * * *",
      "enabled": true,
      "description": "每1小时轻量级健康检查，仅检查状态不触发执行"
    },
    {
      "id": "l4_close_loop",
      "name": "L4 闭环定时任务",
      "command": "/opt/anaconda3/bin/python3 -m scripts.memory_l4.optimize_l4 --close-loop",
      "cron": "0 */6 * * *",
      "enabled": true,
      "description": "每6小时运行一次，执行 Review→Distill→Stats 闭环，确保新案例及时进入进化流程"
    },
    {
      "id": "l4_qmm_update",
      "name": "QMM 实时消费更新",
      "command": "/opt/anaconda3/bin/python3 -m scripts.memory_l4.optimize_l4 --fix-qmm",
      "cron": "0 */4 * * *",
      "enabled": true,
      "description": "每4小时运行一次，更新 QMM 快照，消费最新真实交易案例"
    }
  ],
  "config": {
    "log_dir": "logs",
    "max_log_files": 30,
    "log_file_prefix": "scheduler_"
  }
}
