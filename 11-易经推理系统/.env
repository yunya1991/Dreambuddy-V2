# ===========================================
# 易经推理系统 .env 配置
# 交易所: Hyperliquid (OKX CLI 不可用时的备选方案)
# 创建日期: 2026-08-16
# ===========================================

# ── 交易所选择 ──────────────────────────────
# EXCHANGE=okx 时使用 OKX，EXCHANGE=hyperliquid 时使用 Hyperliquid
EXCHANGE=hyperliquid

# ── Hyperliquid 配置 (HY 易经推理) ──────────
# 钱包地址 (用户地址)
AGENT_YIJING_HYPERLIQUID_USER=0x7Cb9ca369B9e8BB6b761023227C3A39Ac4b031DE
# API 签名者地址
AGENT_YIJING_HYPERLIQUID_SIGNER=0x4b1F9D14388e48e0b911cdF069539eea2d97a37c
# 签名者私钥
AGENT_YIJING_HYPERLIQUID_SIGNER_PRIVATE_KEY=0x729482956a758feeb28b158257270c47f0f865dd6f10a7d74e5305b1c2733e5b

# ── Hyperliquid API 端点 ───────────────────
HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info
HYPERLIQUID_EXCHANGE_URL=https://api.hyperliquid.xyz/exchange

# ── 交易参数 ───────────────────────────────
DEFAULT_LEVERAGE=5
DEFAULT_MARGIN_USDT=100

# ── OKX 配置 (留空，OKX 不可用) ─────────────
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_BASE_URL=https://www.okx.com
OKX_SIMULATED=true
OKX_DRY_RUN=true
OKX_DEFAULT_INST_ID=BTC-USDT-SWAP
OKX_TD_MODE=isolated

# ── 代理配置 (如需要) ───────────────────────
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
